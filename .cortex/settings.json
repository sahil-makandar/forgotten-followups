{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash|sql_execute|.*sql.*|write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cortex/hooks/pretooluse.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cortex/hooks/sessionend.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
